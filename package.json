{
  "name": "bayeux-tapestry-explorer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/secure-static-build.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app components data lib scripts test vite.config.ts vitest.config.ts",
    "format": "oxfmt",
    "test": "vitest run && node --test test/security.test.mjs",
    "test:coverage": "vitest run --coverage",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "release:check": "node scripts/validate-content.mjs --release",
    "beta:check": "node scripts/validate-content.mjs --public-beta",
    "guard:production": "node scripts/guard-production.mjs",
    "guard:vercel": "node scripts/guard-production.mjs --vercel-build",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "pnpm validate:content && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm verify:build"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource/inter": "5.2.8",
    "@fontsource/source-serif-4": "5.2.8",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "openseadragon": "6.1.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "26.1.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "^5.0.0",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
